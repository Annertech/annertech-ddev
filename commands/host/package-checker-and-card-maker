#!/usr/bin/env bash
#ddev-generated
#annertech-ddev

## Description: Scan GitLab projects for composer packages and open Teamwork update cards
## Usage: package-checker-and-card-maker [--dry-run] [--auto-assign] <vendor/package[:max-insecure-version]> [more...]
## Aliases: paccma, paccman
## Example: "ddev paccma drupal/diff drupal/externalauth" \n"ddev paccma --dry-run drupal/diff:1.10" \n"ddev paccma --auto-assign drupal/diff"

set -euo pipefail

# ==============================================================================
# package-checker-and-card-maker (aliases: paccma, paccman)
# ------------------------------------------------------------------------------
# One-step version of: `ddev package-checker ...` followed by manually creating
# Teamwork cards. Scans every project under a GitLab group (default: clients)
# for the given composer packages, then for each matching repo reads its
# .ddev/.env.anner from GitLab to find TEAMWORK_PROJECT_ID and creates a card
# ("Update Dependencies") on that board. Repos without the variable are listed
# so you can handle them manually.
#
#   ddev paccma drupal/diff drupal/externalauth
#   ddev paccma --dry-run drupal/diff:1.10    # show what would happen
#   ddev paccma --auto-assign drupal/diff     # assign created cards to Deputy, Guardian, DM
#
# With a :version suffix only installs <= that version match (same semantics as
# package-checker); without it every project using the package matches.
#
# --auto-assign reads TEAMWORK_DEPUTY_ID, TEAMWORK_GUARDIAN_ID and
# TEAMWORK_DM_ID from each repo's own .ddev/.env.anner (same file the
# TEAMWORK_PROJECT_ID lookup uses) and assigns the created card to whichever
# of those are set.
#
# Env (GitLab side, same as package-checker):
#   GITLAB_GROUP   group path to scan (default: clients)
#   GITLAB_HOST    (glab mode) force a glab host instead of auto-detect
#   GITLAB_URL     (curl mode) GitLab base URL, required
#   GITLAB_TOKEN   (curl mode) token with read_api scope, required
#   PACKAGE_CHECKER_BACKEND  force "glab" or "curl"
#   DEBUG          if set, log every scanned project
# Env (Teamwork side, same as tw-new):
#   TEAMWORK_API_KEY, TEAMWORK_DOMAIN
# Deps: jq, plus either glab OR curl
# ==============================================================================

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo_red()    { echo -e "${RED}$1${NC}" >&2; }
echo_green()  { echo -e "${GREEN}$1${NC}"; }
echo_yellow() { echo -e "${YELLOW}$1${NC}"; }

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib"
. "$LIB_DIR/tw-curl.sh"

# --- args ---------------------------------------------------------------------
DRY_RUN=false
AUTO_ASSIGN=false
PKGS=(); MAXES=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --auto-assign) AUTO_ASSIGN=true ;;
    *:*) PKGS+=("${arg%%:*}"); MAXES+=("${arg#*:}") ;;
    *)   PKGS+=("$arg"); MAXES+=("") ;;
  esac
done
[ "${#PKGS[@]}" -ge 1 ] || { echo "usage: ddev package-checker-and-card-maker [--dry-run] [--auto-assign] <vendor/package[:version]> [more...]" >&2; exit 1; }

TW_API_KEY="${TEAMWORK_API_KEY:-}"
DOMAIN="${TEAMWORK_DOMAIN:-}"
if ! $DRY_RUN && [[ -z "$TW_API_KEY" || -z "$DOMAIN" ]]; then
    echo_red "Error: TEAMWORK_API_KEY and TEAMWORK_DOMAIN environment variables must be set"
    exit 1
fi

CARD_TITLE="Update Dependencies"

GROUP="${GITLAB_GROUP:-clients}"
MANIFEST="composer-manifest.yaml"
ENV_ANNER=".ddev/.env.anner"
GID="${GROUP//\//%2F}"   # url-encode any subgroup slashes

# --- pick GitLab backend (same behaviour as package-checker) ------------------
BACKEND="${PACKAGE_CHECKER_BACKEND:-}"
if [ -z "$BACKEND" ]; then
  if command -v glab >/dev/null 2>&1; then BACKEND=glab; else BACKEND=curl; fi
fi

if [ "$BACKEND" = "glab" ]; then
  command -v glab >/dev/null 2>&1 || { echo "ERROR: glab not installed." >&2; exit 1; }
  api=(glab api)
  [ -n "${GITLAB_HOST:-}" ] && api+=(--hostname "$GITLAB_HOST")

  list_projects() {
    "${api[@]}" --paginate \
      "groups/$GID/projects?include_subgroups=true&archived=false&per_page=100" \
      | jq -rs '.[][] | select(.archived != true) | "\(.id)\t\(.path_with_namespace)\t\(.default_branch // "main")"'
  }
  get_file() { # <id> <branch> <url-encoded path>
    "${api[@]}" "projects/$1/repository/files/$3/raw?ref=$2" 2>/dev/null
  }
  preflight() {
    # glab defaults to gitlab.com when the host can't be inferred from the git
    # remote, silently returning 0 projects. Treat empty as a config error.
    local n
    n=$(list_projects 2>/dev/null | grep -c . || true)
    if [ "${n:-0}" -eq 0 ]; then
      echo "ERROR: glab returned 0 projects for group '$GROUP'." >&2
      echo "  Run from a project on the right GitLab, 'glab auth login'," >&2
      echo "  or set GITLAB_HOST to your GitLab host." >&2
      exit 1
    fi
  }
else
  : "${GITLAB_URL:?curl backend needs GITLAB_URL (your GitLab base URL)}"
  : "${GITLAB_TOKEN:?curl backend needs GITLAB_TOKEN (read_api scope)}"
  hdr=(--header "PRIVATE-TOKEN: $GITLAB_TOKEN")

  list_projects() {
    local page=1 resp
    while :; do
      resp=$(curl -sf "${hdr[@]}" \
        "$GITLAB_URL/api/v4/groups/$GID/projects?include_subgroups=true&archived=false&per_page=100&page=$page")
      [ "$(jq length <<<"$resp")" -eq 0 ] && break
      jq -r '.[] | select(.archived != true) | "\(.id)\t\(.path_with_namespace)\t\(.default_branch // "main")"' <<<"$resp"
      page=$((page+1))
    done
  }
  get_file() { # <id> <branch> <url-encoded path>
    curl -sf "${hdr[@]}" "$GITLAB_URL/api/v4/projects/$1/repository/files/$3/raw?ref=$2"
  }
  preflight() {
    local probe
    probe=$(curl -s -o /dev/null -w '%{http_code}' "${hdr[@]}" "$GITLAB_URL/api/v4/groups/$GID")
    case "$probe" in
      200) ;;
      401) echo "ERROR: 401 unauthorized - bad/expired GITLAB_TOKEN." >&2; exit 1 ;;
      404) echo "ERROR: 404 - group '$GROUP' not found or token lacks access." >&2; exit 1 ;;
      *)   echo "ERROR: GitLab returned HTTP $probe for group '$GROUP'." >&2; exit 1 ;;
    esac
  }
fi

# is version <= max ?  (strip leading v, compare with sort -V)
is_insecure() { # <version> <max>
  local v="${1#v}" m="${2#v}"
  [ "$v" = "$m" ] && return 0
  [ "$(printf '%s\n%s\n' "$v" "$m" | sort -V | head -1)" = "$v" ]
}

# Create the Teamwork card on a project's board. Uses the "Cards" tasklist
# (case-insensitive) or falls back to the first one, like tw-batch-card-maker.
create_card() { # <teamwork-project-id> <description> [comma-separated assignee ids]
  local tw_id="$1" desc="$2" assignees="${3:-}" tl_response tl_status tasklist_id data response http_code body

  tl_response=$(tw_curl -s "https://${DOMAIN}/projects/${tw_id}/tasklists.json")
  [ -n "$tl_response" ] || { echo "failed to fetch tasklists"; return 1; }

  tl_status=$(jq -r '.STATUS' <<<"$tl_response")
  [ "$tl_status" = "OK" ] || { jq -r '.MESSAGE // "API error"' <<<"$tl_response"; return 1; }

  tasklist_id=$(jq -r '
      (.tasklists // []) |
      (map(select(.name | ascii_downcase | contains("cards"))) | first // .[0]) |
      .id // empty' <<<"$tl_response")
  [ -n "$tasklist_id" ] || { echo "no tasklist found"; return 1; }

  data=$(jq -n --arg name "$CARD_TITLE" --arg desc "$desc" --arg assignees "$assignees" \
      '{"todo-item": ({"content": $name, "description": $desc}
          + (if $assignees != "" then {"responsible-party-id": $assignees} else {} end))}')

  response=$(tw_curl -s -w "\n%{http_code}" -X POST \
      -H "Content-Type: application/json" \
      -d "$data" \
      "https://${DOMAIN}/tasklists/${tasklist_id}/tasks.json")

  http_code=$(tail -n1 <<<"$response")
  body=$(head -n-1 <<<"$response")

  if [ "$http_code" -eq 201 ] || [ "$http_code" -eq 200 ]; then
    echo "https://${DOMAIN}/tasks/$(jq -r '.id' <<<"$body")"
  else
    echo "HTTP $http_code"
    return 1
  fi
}

echo "Scanning group '$GROUP' (backend: $BACKEND) ..." >&2
preflight

scanned=0
made=0; manual=0; failed=0
matched_repos=0
made_urls=()   # "repo<TAB>task-url" for the summary

echo "------------------------------------------------"
while IFS=$'\t' read -r id name branch; do
  scanned=$((scanned+1))
  [ -n "${DEBUG:-}" ] && echo "  scanning: $name ($branch)" >&2

  raw=$(get_file "$id" "$branch" "$MANIFEST") || continue

  # collect the queried packages this repo actually uses (no versions)
  repo_pkgs=()
  for i in "${!PKGS[@]}"; do
    pkg="${PKGS[$i]}"; max="${MAXES[$i]}"
    line=$(grep -E "^[[:space:]]+${pkg//\//\\/}:[[:space:]]" <<<"$raw" || true)
    [ -z "$line" ] && continue
    ver=$(head -1 <<<"$line" | sed -E 's/.*:[[:space:]]*//; s/[[:space:]]*$//')
    if [ -z "$max" ] || is_insecure "$ver" "$max"; then
      repo_pkgs+=("$pkg")
    fi
  done
  [ "${#repo_pkgs[@]}" -eq 0 ] && continue
  matched_repos=$((matched_repos+1))

  pkg_list=$(IFS=', '; echo "${repo_pkgs[*]}")

  # look up the Teamwork board id (and, for --auto-assign, the key people
  # ids) from the repo's own .ddev/.env.anner
  tw_id=""
  assignees=""
  if env_raw=$(get_file "$id" "$branch" "${ENV_ANNER//\//%2F}"); then
    tw_id=$(grep -E '^TEAMWORK_PROJECT_ID=' <<<"$env_raw" | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
    if $AUTO_ASSIGN; then
      deputy_id=$(grep -E '^TEAMWORK_DEPUTY_ID=' <<<"$env_raw" | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
      guardian_id=$(grep -E '^TEAMWORK_GUARDIAN_ID=' <<<"$env_raw" | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
      dm_id=$(grep -E '^TEAMWORK_DM_ID=' <<<"$env_raw" | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
      ids=()
      [ -n "$deputy_id" ] && ids+=("$deputy_id")
      [ -n "$guardian_id" ] && ids+=("$guardian_id")
      [ -n "$dm_id" ] && ids+=("$dm_id")
      assignees=$(IFS=,; echo "${ids[*]}")
    fi
  fi

  if [ -z "$tw_id" ]; then
    echo -e "${YELLOW}$name${NC} ($pkg_list): could not make card automatically"
    manual=$((manual+1))
    continue
  fi

  if $DRY_RUN; then
    if [ -n "$assignees" ]; then
      echo -e "${GREEN}$name${NC} ($pkg_list): would make card on Teamwork project $tw_id, assigned to $assignees"
    else
      echo -e "${GREEN}$name${NC} ($pkg_list): would make card on Teamwork project $tw_id"
    fi
    made=$((made+1))
    continue
  fi

  if result=$(create_card "$tw_id" "Please update $pkg_list" "$assignees"); then
    echo -e "${GREEN}$name${NC} ($pkg_list): card made - $result"
    made_urls+=("$name"$'\t'"$result")
    made=$((made+1))
  else
    echo -e "${RED}$name${NC} ($pkg_list): card creation failed ($result)"
    failed=$((failed+1))
  fi
done < <(list_projects | awk -F'\t' '!seen[$1]++')

echo "------------------------------------------------"
echo "Scanned $scanned project(s); $matched_repos matched: ${PKGS[*]}." >&2
if $DRY_RUN; then
  echo_yellow "Dry run - no cards were created."
  [ "$made" -gt 0 ] && echo_green "$made card(s) would be made."
else
  [ "$made" -gt 0 ] && echo_green "$made card(s) made."
  if [ "${#made_urls[@]}" -gt 0 ]; then
    echo_green "=== Cards Created ==="
    for entry in "${made_urls[@]}"; do
      IFS=$'\t' read -r repo url <<< "$entry"
      echo "$repo, $url"
    done
  fi
fi
[ "$manual" -gt 0 ] && echo_yellow "$manual project(s) need a manual card (no TEAMWORK_PROJECT_ID in $ENV_ANNER)."
[ "$failed" -gt 0 ] && { echo_red "$failed card(s) failed to create."; exit 1; }
exit 0
