#!/usr/bin/env bash
#ddev-generated
#annertech-ddev

## Description: List, read and delete emails from the project's Mailpit inbox
## Usage: mail-list [-n LIMIT] [-q QUERY] [--unread] [--json] [--wide] | --show ID | --delete ID | --purge
## Example: "ddev mail-list -n 10 --unread"
## Aliases: mails

set -eu -o pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo_red()    { echo -e "${RED}$1${NC}" >&2; }
echo_green()  { echo -e "${GREEN}$1${NC}"; }
echo_yellow() { echo -e "${YELLOW}$1${NC}"; }

MAILPIT_URL="${MAILPIT_URL:-http://127.0.0.1:8025}"
MAILPIT_URL="${MAILPIT_URL%/}"

LIMIT=20
QUERY=""
JSON=false
WIDE=false
HTML=false
SHOW=""
DELETE=""
PURGE=false
YES=false
INTERACTIVE=auto
FZF_ROWS=false

usage() {
  cat <<'EOF'
Usage: ddev mail-list [options]

List the newest messages from the project's Mailpit inbox.

Options:
  -n, --limit N      Show N messages (default 20)
      --all          Show up to 1000 messages
  -q, --search TEXT  Mailpit search query, e.g. "from:example.com subject:invoice"
      --unread       Only unread messages
      --json         Print the raw API JSON
      --wide         Do not truncate columns
  -i, --interactive  Open the fzf picker (default when run in a terminal)
      --no-interactive
                     Always print the table
  -s, --show ID      Print one message (ID or unique prefix)
      --html         With --show, print the HTML body instead of the text body
      --delete ID    Delete one message (ID or unique prefix)
      --purge        Delete every message in the mailbox
  -y, --yes          Skip the --delete and --purge confirmations
  -h, --help         Show this help

Picker keys:
  Enter              Show the selected message
  Ctrl-D             Delete the selected message
  Ctrl-O             Open the Mailpit web UI
  Esc                Quit

Environment:
  MAILPIT_URL        Mailpit base URL inside the web container
                     (default: http://127.0.0.1:8025)
EOF
}

fail_api() {
  echo_red "Could not reach the Mailpit API at ${MAILPIT_URL}."
  echo_red "Is the project running? Mailpit ships inside the DDEV web container (DDEV >= v1.25)."
}

need_jq() {
  command -v jq >/dev/null 2>&1 || {
    echo_red "jq is required. Install it and try again."
    exit 1
  }
}

fetch() {
  local path="$1" out err
  err=$(mktemp)
  if ! out=$(ddev exec "curl -sS -f --max-time 15 '${MAILPIT_URL}${path}'" 2>"$err"); then
    [ -s "$err" ] && sed 's/^/  /' "$err" >&2
    rm -f "$err"
    return 1
  fi
  rm -f "$err"
  printf '%s' "$out"
}

delete_api() {
  local body="$1"
  ddev exec "curl -sS -f --max-time 15 -X DELETE -H 'Content-Type: application/json' -d '${body}' '${MAILPIT_URL}/api/v1/messages'"
}

urlencode() {
  printf '%s' "$1" | jq -sRr @uri
}

resolve_id() {
  local want="$1" json matches count
  if ! [[ "$want" =~ ^[A-Za-z0-9]+$ ]]; then
    echo_red "Invalid message ID: ${want}"
    return 1
  fi

  # Mailpit IDs are 22 characters; use a full ID without listing the inbox.
  if [ "${#want}" -ge 22 ]; then
    printf '%s' "$want"
    return 0
  fi

  json=$(fetch "/api/v1/messages?limit=1000") || { fail_api; return 1; }
  matches=$(printf '%s' "$json" | jq -r --arg want "$want" '.messages[].ID | select(startswith($want))')
  count=$(printf '%s\n' "$matches" | grep -c . || true)

  if [ "$count" -eq 0 ]; then
    echo_red "No message matches ID prefix '${want}'."
    return 1
  fi
  if [ "$count" -gt 1 ]; then
    echo_red "ID prefix '${want}' is ambiguous, use more characters."
    return 1
  fi

  printf '%s' "$matches"
}

list_path() {
  if [ -n "$QUERY" ]; then
    printf '/api/v1/search?limit=%s&query=%s' "$LIMIT" "$(urlencode "$QUERY")"
  else
    printf '/api/v1/messages?limit=%s' "$LIMIT"
  fi
}

interactive_rows() {
  local json
  json=$(fetch "$(list_path)") || { fail_api; return 1; }

  printf '%s' "$json" | jq -r '
    def addr:
      if (.Name // "") != "" and (.Address // "") != "" then "\(.Name) <\(.Address)>"
      elif (.Address // "") != "" then .Address
      else (.Name // "") end;
    .messages[] |
    [
      .ID,
      (.Created | .[0:16] | sub("T"; " ")),
      (.From | addr),
      ([.To[]? | addr] | join(", ")),
      .Subject,
      ([
        (if .Read then empty else "unread" end),
        (if .Attachments > 0 then "\(.Attachments) att" else empty end),
        (.Tags[]? | "#\(.)")
      ] | join(", ")),
      .Snippet
    ] | @tsv
  '
}

interactive_list() {
  local rows selection id reload_cmd
  rows=$(interactive_rows) || exit 1

  if [ -z "$rows" ]; then
    echo_yellow "No messages found${QUERY:+ matching \"${QUERY}\"}."
    return
  fi

  reload_cmd="ddev mail-list --fzf-rows --limit ${LIMIT}"
  [ -n "$QUERY" ] && reload_cmd+=" --search $(printf '%q' "$QUERY")"

  selection=$(
    printf '%s\n' "$rows" | fzf \
      --reverse \
      --height=80% \
      --delimiter='\t' \
      --with-nth=2,3,4,5,6 \
      --header='Enter: read  Ctrl-D: delete  Ctrl-O: Mailpit UI  Esc: quit' \
      --preview='printf "From:    %s\nTo:      %s\nDate:    %s\nSubject: %s\nFlags:   %s\n\n%s\n" {3} {4} {2} {5} {6} {7}' \
      --preview-window='right:60%:wrap' \
      --bind="ctrl-d:execute(ddev mail-list --delete {1})+reload(${reload_cmd})" \
      --bind='ctrl-o:execute-silent(ddev mailpit)'
  ) || return 0

  [ -z "$selection" ] && return 0

  id=${selection%%$'\t'*}
  SHOW="$id"
  show_message
}

list_messages() {
  local path json total shown unread
  path=$(list_path)

  json=$(fetch "$path") || { fail_api; exit 1; }

  if [ "$JSON" = true ]; then
    printf '%s\n' "$json" | jq .
    return
  fi

  shown=$(printf '%s' "$json" | jq -r '.messages | length')
  total=$(printf '%s' "$json" | jq -r '.messages_count // 0')
  unread=$(printf '%s' "$json" | jq -r '.messages_unread // 0')

  if [ "$shown" -eq 0 ]; then
    echo_yellow "No messages found${QUERY:+ matching \"${QUERY}\"}."
    return
  fi

  {
    printf 'ID\tDATE (UTC)\tFROM\tTO\tSUBJECT\tFLAGS\n'
    printf '%s' "$json" | jq -r --arg wide "$WIDE" '
      def addr:
        if (.Name // "") != "" and (.Address // "") != "" then "\(.Name) <\(.Address)>"
        elif (.Address // "") != "" then .Address
        else (.Name // "") end;
      def cut(n):
        if $wide == "true" then .
        elif length > n then .[0:(n - 1)] + "…"
        else . end;
      .messages[] |
      [
        .ID[0:10],
        (.Created | .[0:16] | sub("T"; " ")),
        (.From | addr | cut(35)),
        ([.To[]? | addr] | join(", ") | cut(30)),
        (.Subject | cut(70)),
        ([
          (if .Read then empty else "unread" end),
          (if .Attachments > 0 then "\(.Attachments) att" else empty end),
          (.Tags[]? | "#\(.)")
        ] | join(", "))
      ] | @tsv
    '
  } | if command -v column >/dev/null 2>&1; then
        column -t -s "$(printf '\t')"
      else
        cat
      fi

  if [ "$total" -gt "$shown" ]; then
    echo_yellow "Showing ${shown} of ${total} messages. Use -n/--limit or --all to see more."
  fi
  if [ "$unread" -gt 0 ]; then
    echo_yellow "${unread} unread."
  fi
}

show_message() {
  local id json
  id=$(resolve_id "$SHOW") || exit 1
  json=$(fetch "/api/v1/message/${id}") || { fail_api; exit 1; }

  if [ "$JSON" = true ]; then
    printf '%s\n' "$json" | jq .
    return
  fi

  printf '%s' "$json" | jq -r --arg html "$HTML" '
    def addr:
      if (.Name // "") != "" and (.Address // "") != "" then "\(.Name) <\(.Address)>"
      elif (.Address // "") != "" then .Address
      else (.Name // "") end;
    "ID:          \(.ID)",
    "Date:        \(.Date)",
    "From:        \(.From | addr)",
    "To:          \([.To[]? | addr] | join(", "))",
    (if (.Cc | length) > 0 then "Cc:          \([.Cc[]? | addr] | join(", "))" else empty end),
    "Subject:     \(.Subject)",
    (if (.Tags | length) > 0 then "Tags:        \(.Tags | join(", "))" else empty end),
    (if (.Attachments | length) > 0 then "Attachments: " + ([.Attachments[] | "\(.FileName) (\(.Size) bytes)"] | join(", ")) else empty end),
    "",
    (if $html == "true" then .HTML
     elif .Text != "" then .Text
     else "(no text body, use --html to print the HTML body)" end)
  '
}

delete_message() {
  local id reply
  id=$(resolve_id "$DELETE") || exit 1

  if [ "$YES" != true ]; then
    if [ ! -t 0 ]; then
      echo_red "Refusing to delete message ${id} in non-interactive mode. Pass --yes."
      exit 1
    fi
    read -r -p "Delete message ${id}? [y/N] " reply
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) echo "Aborted."; return ;;
    esac
  fi

  if delete_api "{\"IDs\":[\"${id}\"]}" >/dev/null; then
    echo_green "Deleted message ${id}."
  else
    fail_api
    exit 1
  fi
}

purge_messages() {
  local json count reply
  json=$(fetch "/api/v1/messages?limit=1") || { fail_api; exit 1; }
  count=$(printf '%s' "$json" | jq -r '.total // 0')

  if [ "$count" -eq 0 ]; then
    echo_yellow "Mailbox is already empty."
    return
  fi

  if [ "$YES" != true ]; then
    if [ ! -t 0 ]; then
      echo_red "Refusing to delete ${count} messages in non-interactive mode. Pass --yes."
      exit 1
    fi
    read -r -p "Delete all ${count} messages? [y/N] " reply
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) echo "Aborted."; return ;;
    esac
  fi

  if delete_api '{}' >/dev/null; then
    echo_green "Deleted all messages."
  else
    fail_api
    exit 1
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--limit) LIMIT="${2:?--limit needs a value}"; shift 2 ;;
    --limit=*) LIMIT="${1#*=}"; shift ;;
    -n*) LIMIT="${1#-n}"; shift ;;
    --all) LIMIT=1000; shift ;;
    -q|--search|--query) QUERY="${2:?--search needs a value}"; shift 2 ;;
    --search=*|--query=*) QUERY="${1#*=}"; shift ;;
    --unread) QUERY="${QUERY:+${QUERY} }is:unread"; shift ;;
    --json) JSON=true; shift ;;
    --wide) WIDE=true; shift ;;
    --html) HTML=true; shift ;;
    -i|--interactive) INTERACTIVE=true; shift ;;
    --no-interactive) INTERACTIVE=false; shift ;;
    --fzf-rows) FZF_ROWS=true; shift ;;
    -s|--show) SHOW="${2:?--show needs a message ID}"; shift 2 ;;
    --show=*) SHOW="${1#*=}"; shift ;;
    --delete) DELETE="${2:?--delete needs a message ID}"; shift 2 ;;
    --delete=*) DELETE="${1#*=}"; shift ;;
    --purge) PURGE=true; shift ;;
    -y|--yes) YES=true; shift ;;
    *) echo_red "Unknown option: $1"; usage >&2; exit 1 ;;
  esac
done

if ! [[ "$LIMIT" =~ ^[0-9]+$ ]] || [ "$LIMIT" -lt 1 ]; then
  echo_red "--limit must be a positive number."
  exit 1
fi

if [ "$LIMIT" -gt 1000 ]; then
  echo_yellow "Mailpit returns at most 1000 messages per request; limiting to 1000."
  LIMIT=1000
fi

actions=0
[ -n "$SHOW" ] && actions=$((actions + 1))
[ -n "$DELETE" ] && actions=$((actions + 1))
[ "$PURGE" = true ] && actions=$((actions + 1))
if [ "$actions" -gt 1 ]; then
  echo_red "Use only one of --show, --delete or --purge."
  exit 1
fi

need_jq

if [ "$FZF_ROWS" = true ]; then
  interactive_rows
  exit $?
fi

if [ "$INTERACTIVE" = auto ]; then
  if [ -t 1 ] && [ "$JSON" = false ] && [ -z "$SHOW" ] && [ -z "$DELETE" ] && [ "$PURGE" = false ] && command -v fzf >/dev/null 2>&1; then
    INTERACTIVE=true
  else
    INTERACTIVE=false
  fi
fi

if [ "$INTERACTIVE" = true ]; then
  command -v fzf >/dev/null 2>&1 || {
    echo_red "fzf is required for the interactive picker."
    exit 1
  }
  [ -t 1 ] || {
    echo_red "The interactive picker needs a terminal."
    exit 1
  }
fi

if [ -n "$SHOW" ]; then
  show_message
elif [ -n "$DELETE" ]; then
  delete_message
elif [ "$PURGE" = true ]; then
  purge_messages
elif [ "$INTERACTIVE" = true ]; then
  interactive_list
else
  list_messages
fi
