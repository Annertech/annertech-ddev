#!/usr/bin/env bash
#ddev-generated
#annertech-ddev

## Description: Fetch this week's Drupal.org security advisories and hand them to package-checker-and-card-maker
## Usage: drupal-sa-card-maker [--dry-run] [--auto-assign] [--verbose] [--days N] [--tags "A,B"]
## Aliases: dsacm
## Example: "ddev dsacm" \n"ddev dsacm --dry-run" \n"ddev dsacm --auto-assign" \n"ddev dsacm --verbose"

set -euo pipefail

# ==============================================================================
# drupal-sa-card-maker (alias: dsacm)
# ------------------------------------------------------------------------------
# Reads https://www.drupal.org/security/all/rss.xml, works out which projects
# had a security release announced in the last N days (default: 7, i.e. "since
# last Wednesday" - Drupal.org publishes SAs on Wednesdays), turns each one
# into its composer namespace (drupal/PROJECT_MACHINE_NAME, and drupal/core for
# Drupal core) plus the advisory's "Affected versions" constraint, prints the
# list, then calls package-checker-and-card-maker with all of them.
#
# Core is handled like any other project: its machine name is "drupal" but the
# composer package is drupal/core, and its advisories cover several branches at
# once (e.g. ">=10.5.0 <10.6.17 || >=11.0.0 <11.3.17 || >=11.4.0 <11.4.7"),
# which is passed through verbatim so only genuinely affected sites match.
#
#   ddev dsacm                  # this week's SAs -> paccma
#   ddev dsacm --dry-run        # show what paccma would do, no cards created
#   ddev dsacm --auto-assign    # forwarded to paccma
#   ddev dsacm --days 14        # widen the window (e.g. after a missed week)
#   ddev dsacm --verbose        # debug: log feed parsing, forwarded to paccma
#
# Created cards are tagged "Security" and "Maintenance" (SA_TAGS); pass
# --tags "..." to override, it is forwarded after the default so it wins.
#
# Any other flag/arg is passed straight through to package-checker-and-card-maker.
# Deps: curl, sed, awk
# ==============================================================================

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo_red()    { echo -e "${RED}$1${NC}" >&2; }
echo_green()  { echo -e "${GREEN}$1${NC}"; }
echo_yellow() { echo -e "${YELLOW}$1${NC}"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FEED_URL="https://www.drupal.org/security/all/rss.xml"
DAYS=7
SA_TAGS="Security,Maintenance"
VERBOSE=0

PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    --days) DAYS="$2"; shift 2 ;;
    -v|--verbose) VERBOSE=1; PASSTHRU+=("$1"); shift ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

echo "Fetching $FEED_URL ..." >&2

feed=$(curl -sf "$FEED_URL") || { echo_red "Error: could not fetch $FEED_URL"; exit 1; }

# Debug output, only with --verbose. Goes to stderr.
vlog() { if [ "$VERBOSE" = 1 ]; then echo "  [verbose] $*" >&2; fi; }

# Undo HTML escaping. Feed fields are escaped once or twice (the version
# constraints are full of < and >), so repeat until nothing changes; &amp;
# goes last, so "&amp;lt;" takes two rounds.
unescape() { # <text>
  local s="$1" prev=""
  while [ "$s" != "$prev" ]; do
    prev="$s"
    s=$(sed -e "s/&lt;/</g; s/&gt;/>/g; s/&quot;/\"/g; s/&#0*39;/'/g; s/&amp;/\\&/g" <<<"$s")
  done
  echo "$s"
}

# Text between the first <start> and the <end> after it, empty when absent.
between() { # <text> <start> <end>
  case "$1" in *"$2"*) ;; *) return 0 ;; esac
  local rest="${1#*"$2"}"
  case "$rest" in *"$3"*) echo "${rest%%"$3"*}" ;; esac
}

# RFC 2822 date (the RSS pubDate) to epoch seconds, GNU or BSD date.
to_epoch() { # <date>
  date -d "$1" +%s 2>/dev/null || date -j -f '%a, %d %b %Y %H:%M:%S %z' "$1" +%s 2>/dev/null
}

cutoff=$(( $(date +%s) - DAYS * 86400 ))
vlog "cutoff: $(date -u -d "@$cutoff" +%FT%TZ 2>/dev/null || date -u -r "$cutoff" +%FT%TZ)"

# For each <item> published within the last $DAYS days, pull the project
# machine name out of the "Project:" field in the description
# (href="/project/SLUG") plus the "Affected versions" field, one
# "slug<US>spec" line per advisory (US = \x1f). Each <item> goes on a line of
# its own first.
found=""
while IFS= read -r item || [ -n "$item" ]; do   # the last item has no trailing newline
  title=$(unescape "$(between "$item" '<title>' '</title>')")
  pub=$(between "$item" '<pubDate>' '</pubDate>')
  epoch=$(to_epoch "$pub") || continue
  if [ "$epoch" -lt "$cutoff" ]; then
    vlog "skip (older than window): $pub $title"
    continue
  fi

  desc=$(unescape "$(between "$item" '<description>' '</description>')")
  slug=$(grep -oE 'href="/project/[a-z0-9_]+"' <<<"$desc" | head -1 | sed -E 's#.*/project/##; s#"$##' || true)
  if [ -z "$slug" ]; then
    vlog "skip (no project link): $title"
    continue
  fi

  spec=""
  case "$desc" in *field-name-field-affected-versions*)
    spec=$(between "${desc#*field-name-field-affected-versions}" '<div class="field-item even">' '</div>' |
      tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//') ;;
  esac
  vlog "use: $pub $title -> $slug [${spec:-no constraint, all versions}]"
  found+="$slug"$'\x1f'"$spec"$'\n'
done < <(tr '\n' ' ' <<<"$feed" | sed 's/<item>/\
/g' | tail -n +2)

# One "namespace<US>spec<US>link" line per project. Several advisories for the
# same project inside the window are merged with "||"; one without a
# constraint matches every install, so it wins. Unit separator: tabs would be
# eaten as whitespace by read (dropping an empty spec), and the specs
# themselves contain "|".
mapping=$(printf '%s' "$found" | awk -F $'\x1f' '
  !($1 in seen) { seen[$1] = 1; order[++n] = $1 }
  $2 == "" { all[$1] = 1 }
  $2 != "" && index(" || " specs[$1] " || ", " || " $2 " || ") == 0 {
    specs[$1] = specs[$1] (specs[$1] == "" ? "" : " || ") $2
  }
  END {
    for (i = 1; i <= n; i++) {
      s = order[i]
      # Composer package names that do not follow the drupal/MACHINE_NAME rule.
      ns = (s == "drupal") ? "drupal/core" : "drupal/" s
      printf "%s\037%s\037https://www.drupal.org/project/%s\n", ns, (s in all ? "" : specs[s]), s
    }
  }')

if [ -z "$mapping" ]; then
  echo_yellow "No security releases found in the last $DAYS day(s)."
  exit 0
fi

echo_green "=== Affected packages (last ${DAYS}d) ==="
namespaces=()
while IFS=$'\x1f' read -r ns spec link; do
  if [ -n "$spec" ]; then
    echo "$ns ($spec) -> $link"
    namespaces+=("$ns:$spec")
  else
    echo "$ns -> $link"
    namespaces+=("$ns")
  fi
done <<<"$mapping"
echo "------------------------------------------------"

exec "$SCRIPT_DIR/package-checker-and-card-maker" --tags "$SA_TAGS" ${PASSTHRU[@]+"${PASSTHRU[@]}"} "${namespaces[@]}"
