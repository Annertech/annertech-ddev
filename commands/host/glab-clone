#!/usr/bin/env bash
#ddev-generated
#annertech-ddev

## Description: Fuzzy pick a GitLab project you have access to and clone it
## Usage: glab-clone [-r|--refresh] [directory]
## Example: "ddev glab-clone" or "ddev glab-clone my-project" or "ddev glab-clone -r"
## Aliases: gclone

set -uo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo_red() { echo -e "${RED}$1${NC}" >&2; }
echo_green() { echo -e "${GREEN}$1${NC}"; }
echo_yellow() { echo -e "${YELLOW}$1${NC}"; }

MISSING_DEPS=()
command -v glab &>/dev/null || MISSING_DEPS+=("glab")
command -v fzf &>/dev/null || MISSING_DEPS+=("fzf")
command -v jq &>/dev/null || MISSING_DEPS+=("jq")
if [ ${#MISSING_DEPS[@]} -gt 0 ]; then
  echo_red "Missing required tools: ${MISSING_DEPS[*]}"
  echo_red "Install them and try again."
  exit 1
fi

REFRESH=false
PRINT_ONLY=false
TARGET_DIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    -r|--refresh) REFRESH=true ;;
    --print-projects) PRINT_ONLY=true ;;
    -h|--help) sed -n '5,8p' "$0"; exit 0 ;;
    -*) echo_red "Unknown option: $1"; exit 1 ;;
    *) TARGET_DIR="$1" ;;
  esac
  shift
done

GLAB_HOST="${ANNERTECH_GITLAB_HOST:-}"
if [ -z "${GLAB_HOST}" ]; then
  GLAB_HOST=$(glab config get host 2>/dev/null)
fi
if [ -z "${GLAB_HOST}" ] || [ "${GLAB_HOST}" = "gitlab.com" ]; then
  echo_red "No self-hosted GitLab host configured."
  echo_red "Set ANNERTECH_GITLAB_HOST, or configure glab: glab config set host your.gitlab.host"
  exit 1
fi

CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/annertech-ddev"
CACHE_FILE="${CACHE_DIR}/glab-projects-${GLAB_HOST//[^a-zA-Z0-9]/_}.tsv"
mkdir -p "${CACHE_DIR}"

cache_is_fresh() {
  [ -s "${CACHE_FILE}" ] || return 1
  # Consider the cache stale after 24 hours.
  local now cache_time
  now=$(date +%s)
  cache_time=$(date -r "${CACHE_FILE}" +%s 2>/dev/null || stat -f %m "${CACHE_FILE}" 2>/dev/null)
  [ -n "${cache_time}" ] || return 1
  [ $(( now - cache_time )) -lt 86400 ]
}

fetch_projects() {
  echo_yellow "Fetching your GitLab projects from ${GLAB_HOST} (this can take a moment)..." >&2
  glab api --hostname "${GLAB_HOST}" --paginate \
    "projects?membership=true&per_page=100&order_by=last_activity_at&simple=true&archived=false" \
    2>/dev/null \
    | jq -r '.[] | [.name_with_namespace, .ssh_url_to_repo, .path] | @tsv'
}

# Used by the fzf ctrl-r binding to rebuild and print the list.
if [ "${PRINT_ONLY}" = true ]; then
  TMP_FILE=$(mktemp)
  if fetch_projects > "${TMP_FILE}" 2>/dev/null && [ -s "${TMP_FILE}" ]; then
    mv "${TMP_FILE}" "${CACHE_FILE}"
  else
    rm -f "${TMP_FILE}"
  fi
  [ -s "${CACHE_FILE}" ] && cat "${CACHE_FILE}"
  exit 0
fi

if [ "${REFRESH}" = true ] || ! cache_is_fresh; then
  TMP_FILE=$(mktemp)
  if ! fetch_projects > "${TMP_FILE}" || [ ! -s "${TMP_FILE}" ]; then
    rm -f "${TMP_FILE}"
    echo_red "Could not fetch the project list from ${GLAB_HOST}."
    echo_red "Check that you are authenticated: glab auth status"
    exit 1
  fi
  mv "${TMP_FILE}" "${CACHE_FILE}"
fi

SELECTION=$(fzf --reverse --height=50% --header="Clone from ${GLAB_HOST} (ctrl-r to refresh list)" \
  --delimiter=$'\t' --with-nth=1 \
  --bind "ctrl-r:reload(${0} --print-projects)" \
  < "${CACHE_FILE}")

if [ -z "${SELECTION}" ]; then
  echo_yellow "Nothing selected, aborting."
  exit 0
fi

PROJECT_NAME=$(cut -f1 <<< "${SELECTION}")
SSH_URL=$(cut -f2 <<< "${SELECTION}")
DEFAULT_DIR=$(cut -f3 <<< "${SELECTION}")

if [ -z "${TARGET_DIR}" ]; then
  read -r -p "Directory to clone into [${DEFAULT_DIR}]: " TARGET_DIR
  TARGET_DIR="${TARGET_DIR:-${DEFAULT_DIR}}"
fi

# When run from inside a git repository, clone next to it, not into it.
CLONE_BASE="."
GIT_TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "${GIT_TOPLEVEL}" ] && [[ "${TARGET_DIR}" != /* ]]; then
  CLONE_BASE=$(dirname "${GIT_TOPLEVEL}")
  echo_yellow "Inside a git repository, cloning into ${CLONE_BASE} instead."
fi
TARGET_PATH="${CLONE_BASE%/}/${TARGET_DIR}"
[[ "${TARGET_DIR}" == /* ]] && TARGET_PATH="${TARGET_DIR}"

if [ -e "${TARGET_PATH}" ]; then
  echo_red "'${TARGET_PATH}' already exists, aborting."
  exit 1
fi

echo_green "Cloning ${PROJECT_NAME} into ${TARGET_PATH}"
if git clone "${SSH_URL}" "${TARGET_PATH}"; then
  echo_green "Done. cd ${TARGET_PATH}"
else
  echo_red "Clone failed."
  exit 1
fi
