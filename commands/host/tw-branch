#!/usr/bin/env bash
#ddev-generated
#annertech-ddev

## Description: Pick one of your assigned Teamwork cards and create a git branch for it
## Usage: tw-branch
## Example: "ddev tw-branch"

set -eo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
echo_red()    { echo -e "${RED}$1${NC}" >&2; }
echo_green()  { echo -e "${GREEN}$1${NC}"; }
echo_yellow() { echo -e "${YELLOW}$1${NC}"; }

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_lib"
. "$LIB_DIR/tw-curl.sh"

TW_API_KEY="${TEAMWORK_API_KEY:-}"
DOMAIN="${TEAMWORK_DOMAIN:-}"
if [[ -z "$TW_API_KEY" || -z "$DOMAIN" ]]; then
    echo_red "Error: TEAMWORK_API_KEY and TEAMWORK_DOMAIN environment variables must be set"
    exit 1
fi

for dep in jq fzf; do
    command -v "$dep" &> /dev/null || { echo_red "Error: missing dependency: $dep"; exit 1; }
done

ENV_FILE=".ddev/.env.anner"
TW_PROJECT_ID=""
if [ -f "$ENV_FILE" ]; then
    TW_PROJECT_ID=$(grep -E '^TEAMWORK_PROJECT_ID=' "$ENV_FILE" | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
fi
if [ -z "$TW_PROJECT_ID" ]; then
    echo_red "Error: TEAMWORK_PROJECT_ID is not set in $ENV_FILE"
    exit 1
fi

echo_yellow "Fetching your Teamwork user..."
ME_RESPONSE=$(tw_curl -s "https://${DOMAIN}/projects/api/v3/me.json")
ME_ID=$(echo "$ME_RESPONSE" | jq -r '.person.id // empty' 2>/dev/null || true)
if [ -z "$ME_ID" ]; then
    echo_red "Error: could not determine your Teamwork user ID. Check TEAMWORK_API_KEY."
    exit 1
fi

echo_yellow "Fetching your cards in project ${TW_PROJECT_ID}..."
TASKS_RESPONSE=$(tw_curl -s -G \
    --data-urlencode "projectIds=${TW_PROJECT_ID}" \
    --data-urlencode "responsiblePartyIds=${ME_ID}" \
    --data-urlencode "includeCompletedTasks=false" \
    --data-urlencode "pageSize=250" \
    "https://${DOMAIN}/projects/api/v3/tasks.json")

TASKS=$(echo "$TASKS_RESPONSE" | jq -r --argjson me "$ME_ID" \
    '.tasks[]? | select(.status != "completed" and ((.assigneeUserIds // []) | index($me))) | "\(.id)\t\(.name)"' \
    2>/dev/null || true)
if [ -z "$TASKS" ]; then
    echo_red "No open cards assigned to you in project ${TW_PROJECT_ID}."
    exit 0
fi

SELECTION=$(echo "$TASKS" | \
    fzf --reverse --height=50% --header="Select a card to branch from" \
        --delimiter=$'\t' --with-nth=1,2)
if [ -z "$SELECTION" ]; then
    echo_red "No card selected. Aborting."
    exit 0
fi

TASK_ID=$(echo "$SELECTION" | cut -f1)
TASK_TITLE=$(echo "$SELECTION" | cut -f2-)

read -e -r -p "$(echo -e "${YELLOW}Create a git branch for ${TASK_ID} (${TASK_TITLE})? (y/n): ${NC}")" CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy] ]]; then
    exit 0
fi

ddev branch "$TASK_ID"
